# OpenShop non-secret runtime configuration (example).
# Install as /etc/openshop/openshop.env, root-owned mode 600; never commit real keys.
# The API credential belongs in /etc/openshop/openshop_ai.token, loaded by systemd
# LoadCredential (see deploy/systemd/openshop.service).
OPENSHOP_AI_ENABLED=1
OPENSHOP_AI_BASE_URL=https://your-openai-compatible-gateway.example/v1
OPENSHOP_AI_MODEL=deepseek-flash
OPENSHOP_AI_MODEL_LABEL=DeepSeek Flash
OPENSHOP_AI_TIMEOUT_SECONDS=75
OPENSHOP_AI_MAX_OUTPUT_TOKENS=4000
OPENSHOP_AI_GLOBAL_DAILY_LIMIT=60
OPENSHOP_AI_USER_DAILY_LIMIT=4
OPENSHOP_AI_IP_WINDOW_LIMIT=3
OPENSHOP_AI_IP_WINDOW_SECONDS=600
